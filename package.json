{
  "name": "@pushizo/react-native",
  "version": "0.1.0",
  "description": "Pushizo React Native SDK: push aboneliği, kullanıcı/tag, e-posta/SMS, in-app mesajlar, bildirim kutusu ve Expo config plugin (Android + iOS).",
  "license": "MIT",
  "author": "Pushizo <bildirim@pushizo.com>",
  "homepage": "https://docs.pushizo.com/docs/sdk/react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushizo/pushizo-react-native.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/src",
    "ios",
    "plugin/build",
    "plugin/templates",
    "app.plugin.js",
    "react-native.config.js",
    "pushizo-react-native.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:plugin",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin/tsconfig.json",
    "test": "jest",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "push",
    "notifications",
    "in-app",
    "pushizo"
  ],
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "dependencies": {
    "@expo/config-plugins": "^57.0.10",
    "@expo/image-utils": "^0.11.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "codegenConfig": {
    "name": "RNPushizoSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.pushizo.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "Pushizo": "PushizoRN"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
