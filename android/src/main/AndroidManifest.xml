<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Erken başlatma (isteğe bağlı): uygulama manifestinde com.pushizo.reactnative.app_id meta-data'sı varsa SDK
          Application.onCreate öncesinde başlatılır. Yoksa sağlayıcı hiçbir şey yapmaz. Düşük initOrder: Firebase ve
          androidx.startup (WorkManager, ProcessLifecycleOwner) sağlayıcılarından sonra çalışır.
        -->
        <provider
            android:name="com.pushizo.reactnative.PushizoInitProvider"
            android:authorities="${applicationId}.pushizo-init"
            android:exported="false"
            android:initOrder="-100" />
    </application>
</manifest>
